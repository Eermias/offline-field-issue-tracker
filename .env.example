# Local offline store (SQLite) — keep these
DB_DRIVER=sqlite
SQLITE_PATH=./data/field-issues.sqlite

# Central shared DB — Prisma Postgres (free for development)
# 1) Create DB at https://console.prisma.io
# 2) Paste the connection string below
# 3) Run: npm run migrate:central --prefix backend
# See dbsetup.md for full steps.
CENTRAL_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

PORT=3001
NODE_ENV=development

# Auth (change these outside demos)
JWT_SECRET=change-me-in-production
MANAGER_SIGNUP_KEY=Manager123

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:3001/api
